<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="repository.techamreplay" name="TECHAM Replay Repository" version="1.0.2" provider-name="TECHAM Studio">
    <extension point="xbmc.addon.repository">
      <info compressed="false">https://techam259.github.io/kodi/addons.xml</info>
      <checksum>https://techam259.github.io/kodi/addons.xml.md5</checksum>
      <datadir zip="true">https://techam259.github.io/kodi/zips/</datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="it_IT">Repository ufficiale degli add-on TECHAM Replay.</summary>
      <description lang="it_IT">Installa e aggiorna automaticamente TECHAM Replay Sync per Kodi.</description>
      <platform>all</platform>
    </extension>
  </addon>
  <addon id="plugin.video.techamreplay" name="TECHAM Replay Sync" version="0.1.0" provider-name="TECHAM Studio">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.service" library="service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
      <summary lang="it_IT">Sincronizza lo stato di visione di Kodi con TECHAM Replay.</summary>
      <description lang="it_IT">Registra film ed episodi visti nel profilo TECHAM Replay dell'utente.</description>
      <platform>all</platform>
      <license>Proprietary</license>
      <source>https://replay.techamstudio.com</source>
    </extension>
  </addon>
</addons>
